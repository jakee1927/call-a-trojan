# LLM provider: openai (default) or anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
# defaults to gpt-6-astra (OpenAI's flagship); gpt-6.1-sol is ~5x cheaper
OPENAI_MODEL=gpt-6-astra
# optional: faster model for voice lookups (e.g. gpt-6.1-terra); falls back to OPENAI_MODEL
OPENAI_VOICE_MODEL=
# optional: only needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HELPER_PASSCODE=
DISCORD_WEBHOOK_URL=
# public base URL used in Discord deep links (e.g. https://call-a-trojan.vercel.app)
NEXT_PUBLIC_SITE_URL=
# voice session adds its own (e.g. TWILIO_*) below
NEXT_PUBLIC_FEATURE_SHOWME=1
NEXT_PUBLIC_FEATURE_CALL=1
NEXT_PUBLIC_FEATURE_FUTURE=1
NEXT_PUBLIC_FEATURE_ORG_USG=1
