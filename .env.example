# LLM provider: openai (default) or anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
# defaults to gpt-6.1-terra (fast, $1/$5 per M tokens); gpt-6-astra is the flagship (10x the price)
OPENAI_MODEL=gpt-6.1-terra
# optional: faster model for voice lookups (e.g. gpt-6-luna); falls back to OPENAI_MODEL
OPENAI_VOICE_MODEL=
# optional: only needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HELPER_PASSCODE=
DISCORD_WEBHOOK_URL=
# public base URL used in Discord deep links (e.g. https://call-a-trojan.vercel.app)
NEXT_PUBLIC_SITE_URL=
# voice session adds its own (e.g. TWILIO_*) below
NEXT_PUBLIC_FEATURE_SHOWME=1
NEXT_PUBLIC_FEATURE_CALL=1
NEXT_PUBLIC_FEATURE_FUTURE=1
NEXT_PUBLIC_FEATURE_ORG_USG=1

# ---- Voice & calling (voice session) ----
# AI Trojan stand-in (OpenAI Realtime over WebRTC). Uses OPENAI_API_KEY above. Optional overrides:
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# auto = ring an on-shift human Trojan if there is one, else AI; ai / human force a path (URL ?call= wins)
NEXT_PUBLIC_CALL_DEFAULT=auto
# Real phone calls to a human Trojan (Twilio Programmable Voice). Leave blank to use the in-app ringing fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_FROM_NUMBER=
# public phone line shown as "Or just call" (E.164, e.g. +12135551234); empty hides it
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_FEATURE_PHONE=1

# Phone line (public number → AI Trojan over OpenAI Realtime SIP → transfer to an on-shift Trojan)
OPENAI_SIP_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
# Optional: VOICE_PHONE_AI=0 skips the AI (calls ring a Trojan directly); VOICE_SMS=0 turns texts off;
# OPENAI_SIP_URI overrides the SIP target (e.g. add ;secure=true); VOICE_PHONE_MAX_SECONDS (default 270)
# Typed answers and call lookups search the live web (usc.edu first) for anything the saved pages miss, and flag every non-USC source under the answer; ASK_WEB_SEARCH=0 turns it off.
# If that engine fails, calls fall back to a plain web search (VOICE_WEB_SEARCH=0 off; VOICE_WEB_MODEL, default gpt-6-luna).
# Phone-line texts are queued for the Mac relay (node src/voice/relay/text-relay.mjs); VOICE_TWILIO_SMS=1 also sends via Twilio once A2P 10DLC is approved.
